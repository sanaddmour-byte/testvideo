{
  "name": "dcp-waterproofing-film",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "data": "python3 tools/build_catalogue.py && python3 tools/build_qa.py && python3 tools/build_script.py",
    "validate": "npm run data --silent && tsx scripts/validate.ts",
    "audio:scan": "tsx scripts/audio-scan.ts",
    "stills": "tsx scripts/stills.ts",
    "render:chapters": "npm run audio:scan --silent && tsx scripts/render.ts chapters",
    "render:master": "npm run audio:scan --silent && tsx scripts/render.ts master",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@remotion/bundler": "^4.0.542",
    "@remotion/cli": "^4.0.542",
    "@remotion/renderer": "^4.0.542",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.542"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
